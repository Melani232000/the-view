# Firebase WEB config of the project (Firebase console > Project settings >
# Your apps > Web app, or: firebase apps:sdkconfig WEB --project aibrasper).
# Copy this file to .env (git-ignored) and fill it in. Never commit .env.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=aibrasper.firebaseapp.com
FIREBASE_PROJECT_ID=aibrasper
FIREBASE_STORAGE_BUCKET=aibrasper.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
